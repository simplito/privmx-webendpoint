#!/bin/bash
# Starts a PrivMX Bridge for `example/vite` and writes its `.env.local`.
#
# Reuses the e2e stack: Mongo from tests/compose.yaml and the seed data in
# tests/datasets/defaultDataset (api key + solution + contexts), so the example
# gets a working Solution/Context without any admin-panel clicking. Separate
# container, port and database from the e2e workers, so both can coexist.
#
#   scripts/example_bridge          start (idempotent - recreates the container)
#   scripts/example_bridge stop     stop and remove it
set -e

SCRIPT_PATH=$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)
ROOT="$SCRIPT_PATH/.."

IMAGE="${BRIDGE_IMAGE:-hub.simplito.com/privmx/privmx-bridge:dev}"
CONTAINER="privmx_example_bridge"
PORT="${BRIDGE_PORT:-9111}"
DB="privmx_example_db"
MONGO_CONTAINER="privmx_test_mongo"
NETWORK="tests_default"

if [ "$1" = "stop" ]; then
    docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
    echo "Removed $CONTAINER. Mongo is left running (shared with the e2e tests)."
    exit 0
fi

wait_ready() {
    local deadline=$((SECONDS + 60))
    while [ $SECONDS -lt $deadline ]; do
        if curl -fs "http://localhost:$PORT/privmx-configuration.json" >/dev/null; then return 0; fi
        if [ "$(docker inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" != "true" ]; then
            docker logs --tail 30 "$CONTAINER"
            echo "Error: $CONTAINER stopped unexpectedly." >&2
            exit 1
        fi
        sleep 0.5
    done
    docker logs --tail 30 "$CONTAINER"
    echo "Error: Bridge did not become ready on port $PORT within 60s." >&2
    exit 1
}

echo "Starting Mongo (tests/compose.yaml)..."
docker compose -f "$ROOT/tests/compose.yaml" up -d test_mongodb

echo "Starting Bridge $IMAGE on port $PORT..."
docker rm -f "$CONTAINER" >/dev/null 2>&1 || true
# Drop BEFORE the first boot: the Bridge records applied migrations in this
# database, so dropping it afterwards makes the next start fail to migrate.
docker exec "$MONGO_CONTAINER" mongosh --quiet --eval "db.getSiblingDB('$DB').dropDatabase()" >/dev/null
docker run -d --name "$CONTAINER" -p "$PORT:3000" \
    --network "$NETWORK" \
    -e PRIVMX_PORT=3000 \
    -e "PRIVMX_MONGO_URL=mongodb://test_mongodb:27017/$DB" \
    -e PRIVMX_WORKERS=1 \
    -e PMX_MIGRATION=Migration067AddNotificationCollection \
    -e PRIVMX_HOSTNAME=0.0.0.0 \
    "$IMAGE" >/dev/null

# The Bridge initialises the database on first boot; the seed data has to go in
# afterwards, with the Bridge stopped so it re-reads it on the next start.
wait_ready
docker stop "$CONTAINER" >/dev/null

echo "Seeding solution/context/api key..."
for f in "$ROOT"/tests/datasets/defaultDataset/*.json; do
    coll=$(basename "$f" .json)
    docker exec -i "$MONGO_CONTAINER" mongoimport --quiet \
        --db "$DB" --collection "$coll" --jsonArray <"$f"
done

docker start "$CONTAINER" >/dev/null
wait_ready

# Values come from the seed data - see tests/datasets/testData.ts.
# bug/reproduce is a scratch dir that is not in the repo, so skip what is absent.
WROTE=""
for example in example/vite example/group-chat example/secure-intake bug/reproduce; do
    [ -d "$ROOT/$example" ] || continue
    WROTE="$WROTE $example"
    cat >"$ROOT/$example/.env.local" <<EOF
# Generated by scripts/example_bridge - local demo Bridge, throwaway credentials.

# The Bridge serves no CORS headers, so the dev server proxies same-origin /api
# (and the event WebSocket on that path) to it, and VITE_PRIVMX_BRIDGE_URL stays
# empty (= this page's own origin).
PRIVMX_BRIDGE_PROXY=http://localhost:$PORT
VITE_PRIVMX_BRIDGE_URL=
VITE_PRIVMX_SOLUTION_ID=G7J8Pm4op76xCcv9gNVqsQkmFcJ
VITE_PRIVMX_CONTEXT_ID=662115304034ea5684acac8b
VITE_PRIVMX_API_KEY_ID=34ed9fd355a81d81cc5f984dfab7595a
VITE_PRIVMX_API_KEY_SECRET=e4c21122523e8d8a6643c35b41440e61
EOF
done

echo
echo "Bridge ready at http://localhost:$PORT"
echo "Wrote .env.local for:$WROTE"
echo "Next:  cd example/group-chat && npm install && npm run dev"
echo "Stop:  scripts/example_bridge stop"
