# Copy to `.env.local`, then restart `npm run dev`.
#
# ⚠️ These are VITE_-prefixed, so Vite EXPOSES them to the browser. That is only
# acceptable here because this demo MIMICS the backend in-browser (see
# src/server.ts). In a real app, the API key lives on your server and is NEVER
# shipped to the client - the browser would call your backend over HTTP instead.

# Base URL of your PrivMX Bridge, e.g. http://localhost:9111
VITE_PRIVMX_BRIDGE_URL=

# Solution ID - from the PrivMX Bridge admin panel.
VITE_PRIVMX_SOLUTION_ID=

# Context ID the demo user will be added to (create one in the admin panel/CLI).
VITE_PRIVMX_CONTEXT_ID=

# Management API key (server credential - see the warning above).
VITE_PRIVMX_API_KEY_ID=
VITE_PRIVMX_API_KEY_SECRET=
