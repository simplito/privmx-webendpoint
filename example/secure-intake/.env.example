# Copy to `.env.local`, then restart `npm run dev`.
#
# From the repo root, `scripts/example_bridge` starts a local Bridge and writes
# this file for you.
#
# ⚠️ The VITE_-prefixed values are EXPOSED to the browser. That is only
# acceptable here because this demo MIMICS the backend in-browser (see
# src/server.ts). In a real app the API key lives on your server and is NEVER
# shipped to the client - the browser would call your backend over HTTP instead.

# Where the dev server forwards same-origin /api (including the event
# WebSocket). No VITE_ prefix: it stays on the dev server, out of the browser.
# Needed because a bare Bridge serves no CORS headers.
PRIVMX_BRIDGE_PROXY=http://localhost:9111

# Leave EMPTY to use this page's own origin (the proxy above). Set it only when
# your Bridge serves CORS itself, e.g. https://bridge.example.com
VITE_PRIVMX_BRIDGE_URL=

# Solution ID - from the PrivMX Bridge admin panel.
VITE_PRIVMX_SOLUTION_ID=

# Context ID the demo users will be added to (create one in the admin panel/CLI).
VITE_PRIVMX_CONTEXT_ID=

# Management API key (server credential - see the warning above).
VITE_PRIVMX_API_KEY_ID=
VITE_PRIVMX_API_KEY_SECRET=
